---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import QuoteCalculator from '../../components/QuoteCalculator.astro';
import { locations } from '../../data/locations';
import type { LocationData } from '../../data/locations';

export async function getStaticPaths() {
  return locations.map(location => ({
    params: { city: location.slug },
    props: { location },
  }));
}

interface Props {
  location: LocationData;
}

const { location } = Astro.props;

const title = `Mobile Line Boring ${location.city}, ON | 24/7 On-Site Heavy Equipment Repair`;
const description = `Mobile line boring and bore welding services in ${location.city}, Ontario. 24/7 emergency on-site machining for excavators, loaders, and construction equipment. Response time: ${location.responseTime}.`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={`/locations/${location.slug}`}
  schema="Service"
  serviceType="Mobile Line Boring"
  areaServed={[location.city, ...location.nearbyTowns]}
  faqs={location.localizedFaqs}
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="bg-gradient-to-r from-blue-700 to-blue-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <nav aria-label="Breadcrumb" class="mb-6 text-blue-200 text-sm">
            <ol class="flex items-center space-x-2">
              <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
              <li aria-hidden="true">›</li>
              <li><a href="/#locations" class="hover:text-white transition-colors">Locations</a></li>
              <li aria-hidden="true">›</li>
              <li class="text-white font-medium" aria-current="page">{location.city}</li>
            </ol>
          </nav>

          <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-6">
            {location.localizedH1}
          </h1>

          <div class="flex flex-wrap gap-4 text-blue-100 text-sm mb-8">
            <span class="flex items-center space-x-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>Response time: <strong class="text-white">{location.responseTime}</strong></span>
            </span>
            <span class="flex items-center space-x-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <span>Area code: <strong class="text-white">({location.areaCode})</strong></span>
            </span>
            <span>📍 24/7 Emergency Dispatch</span>
          </div>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/emergency/24-7-line-boring"
              class="bg-red-600 hover:bg-red-700 text-white px-8 py-4 rounded-lg font-bold text-lg transition-colors flex items-center justify-center space-x-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
              <span>Emergency Service</span>
            </a>
            <a
              href="#quote"
              class="bg-white hover:bg-gray-100 text-blue-700 px-8 py-4 rounded-lg font-bold text-lg transition-colors flex items-center justify-center"
            >
              Get Free Estimate
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Localized Content -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto prose prose-lg text-gray-700">
          {location.localizedIntro.split('\n\n').map(paragraph => (
            <p class="mb-4 leading-relaxed">{paragraph}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 text-center mb-10">
          Services Available in {location.city}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {[
            { href: '/services/mobile-line-boring', title: 'Mobile Line Boring', desc: 'On-site precision bore restoration to OEM specs without moving your equipment.' },
            { href: '/services/bore-welding-repair', title: 'Bore Welding Repair', desc: 'Weld buildup of worn bores before precision machining, extending equipment life.' },
            { href: '/services/pin-bushing-replacement', title: 'Pin & Bushing Replacement', desc: 'Complete pivot point repair including removal, installation, and testing.' },
          ].map(svc => (
            <a href={svc.href} class="bg-white rounded-xl p-6 shadow hover:shadow-md transition-shadow border border-gray-100 group">
              <h3 class="text-lg font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2">{svc.title}</h3>
              <p class="text-gray-600 text-sm mb-3">{svc.desc}</p>
              <span class="text-blue-600 text-sm font-semibold group-hover:underline">Learn more →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Service Area -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Also Serving Nearby Communities</h2>
        <div class="flex flex-wrap gap-2">
          {location.nearbyTowns.map(town => (
            <span class="bg-blue-50 text-blue-700 px-3 py-1 rounded-full text-sm font-medium">
              {town}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Industries -->
    <section class="py-12 bg-gray-50">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Industries We Serve in {location.city}</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {location.industries.map(industry => (
            <li class="flex items-center space-x-2 text-gray-700 capitalize">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="capitalize">{industry}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQs -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">
          Frequently Asked Questions — {location.city}
        </h2>
        <div class="space-y-6">
          {location.localizedFaqs.map(faq => (
            <details class="bg-gray-50 rounded-lg p-6 group">
              <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
                <span>{faq.question}</span>
                <svg class="w-5 h-5 text-blue-600 flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <p class="mt-4 text-gray-700 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Quote Calculator -->
    <section id="quote" class="py-16 bg-blue-50">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto">
          <div class="text-center mb-8">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Get a Free Preliminary Estimate</h2>
            <p class="text-gray-600">For {location.city} and the surrounding area</p>
          </div>
          <QuoteCalculator />
        </div>
      </div>
    </section>

    <!-- Emergency CTA -->
    <section class="py-12 bg-red-600 text-white">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Equipment Down in {location.city}?</h2>
        <p class="text-red-100 mb-6">Our mobile technicians provide 24/7 emergency line boring service across the {location.city} area.</p>
        <a
          href="/emergency/24-7-line-boring"
          class="inline-block bg-white text-red-600 hover:bg-red-50 px-8 py-4 rounded-lg font-bold text-lg transition-colors"
        >
          View Emergency Service Options
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
