---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteCalculator from '../components/QuoteCalculator.astro';
import { services } from '../data/services';
import { locations } from '../data/locations';

const title = 'Mobile Line Boring Ontario | 24/7 Emergency On-Site Machining';
const description = 'Professional mobile line boring services across Ontario. Emergency 24/7 on-site machining for heavy equipment in Guelph, Peterborough, Kingston, Sarnia & Belleville. Get a quote in 60 seconds.';
---

<BaseLayout title={title} description={description} schema="Service">
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-20 md:py-28">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center space-y-6">
          <h1 class="text-4xl md:text-6xl font-bold leading-tight">
            Mobile Line Boring Services Across Ontario
          </h1>
          <p class="text-xl md:text-2xl text-blue-100">
            Emergency 24/7 on-site machining for heavy equipment. We come to you - minimize downtime, maximize productivity.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center pt-4">
            <a 
              href="/emergency/24-7-line-boring"
              class="bg-red-600 hover:bg-red-700 text-white px-8 py-4 rounded-lg font-bold text-lg transition-colors flex items-center justify-center space-x-2"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
              <span>24/7 Emergency Service</span>
            </a>
            <a 
              href="#quote"
              class="bg-white hover:bg-gray-100 text-blue-600 px-8 py-4 rounded-lg font-bold text-lg transition-colors"
            >
              Get Quote in 60 Seconds
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Overview -->
    <section class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Our Line Boring Services</h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Professional on-site machining and repair services for heavy equipment across Ontario
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {services.map(service => (
            <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
              <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-3">{service.title}</h3>
              <p class="text-gray-600 mb-4">{service.description}</p>
              <ul class="space-y-2 mb-6">
                {service.benefits.slice(0, 3).map(benefit => (
                  <li class="flex items-start space-x-2 text-sm text-gray-600">
                    <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
              <a 
                href={`/services/${service.slug}`}
                class="text-blue-600 font-semibold hover:text-blue-700 transition-colors inline-flex items-center space-x-1"
              >
                <span>Learn More</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Service Areas -->
    <section class="py-16 md:py-20 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Serving Ontario's Tier 2 & 3 Cities</h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Rapid response mobile line boring services across Southern and Eastern Ontario
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
          {locations.map(location => (
            <a 
              href={`/locations/${location.slug}`}
              class="bg-white rounded-lg p-6 text-center hover:shadow-lg transition-shadow group"
            >
              <div class="text-2xl font-bold text-blue-600 mb-2 group-hover:text-blue-700">
                {location.city}
              </div>
              <p class="text-sm text-gray-500">
                {location.areaCode} Area
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Why Choose Ontario Mobile Line Boring?</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-gray-900 mb-2">24/7 Emergency Response</h3>
                <p class="text-gray-600">Equipment breakdown doesn't wait for business hours. Our technicians are on call around the clock to minimize your downtime.</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-gray-900 mb-2">On-Site Service</h3>
                <p class="text-gray-600">We bring our precision machining equipment to your location - no need to transport heavy machinery to a shop.</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-gray-900 mb-2">OEM Precision</h3>
                <p class="text-gray-600">All repairs meet or exceed original equipment manufacturer specifications with laser-accurate measurements.</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-gray-900 mb-2">Cost-Effective</h3>
                <p class="text-gray-600">Save 50-70% compared to component replacement. Extend equipment life and avoid costly downtime.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 md:py-20 bg-blue-600 text-white">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Ready to Get Started?</h2>
        <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
          Get an instant quote for your line boring project or call us for emergency 24/7 service.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="tel:+1-519-555-0123"
            class="bg-white hover:bg-gray-100 text-blue-600 px-8 py-4 rounded-lg font-bold text-lg transition-colors flex items-center justify-center space-x-2"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <!-- TODO: Replace with real phone number -->
            <span>Call (519) 555-0123</span>
          </a>
          <a 
            href="#quote"
            class="bg-red-600 hover:bg-red-700 text-white px-8 py-4 rounded-lg font-bold text-lg transition-colors"
          >
            Get Instant Quote
          </a>
        </div>
      </div>
    </section>

    <!-- Quote Calculator Section -->
    <section id="quote" class="py-16 md:py-20 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto">
          <div class="text-center mb-8">
            <h2 class="text-3xl font-bold text-gray-900 mb-2">Get a Free Preliminary Estimate</h2>
            <p class="text-gray-600">Fill out the form below for a quick price range on your line boring project.</p>
          </div>
          <QuoteCalculator />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
