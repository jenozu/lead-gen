---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = '24/7 Emergency Line Boring Ontario | Rapid On-Site Heavy Equipment Repair';
const description = 'Emergency mobile line boring services across Ontario — 24/7, including weekends and holidays. Rapid on-site response for excavators, loaders, and heavy equipment. Downtime cost calculator included.';

const responseTimes = [
  { city: 'Guelph', time: '2–4 hours', slug: 'guelph' },
  { city: 'Peterborough', time: '3–5 hours', slug: 'peterborough' },
  { city: 'Kingston', time: '3–5 hours', slug: 'kingston' },
  { city: 'Sarnia', time: '4–6 hours', slug: 'sarnia' },
  { city: 'Belleville', time: '4–6 hours', slug: 'belleville' },
];

const emergencySteps = [
  {
    num: '1',
    title: 'Call Us Now',
    desc: 'Reach our 24/7 dispatch line. Describe your equipment, location, and the nature of the failure. We will confirm coverage and give you an ETA.',
  },
  {
    num: '2',
    title: 'We Dispatch a Technician',
    desc: 'A qualified mobile line boring technician is dispatched with all required equipment — boring machine, welding rig, press, and precision instruments.',
  },
  {
    num: '3',
    title: 'On-Site Assessment',
    desc: 'The technician inspects the worn bore, measures the damage, and confirms the repair scope and pricing before work begins.',
  },
  {
    num: '4',
    title: 'Repair Completed On-Site',
    desc: 'The bore is restored to OEM specification — welded if needed, line-bored to tolerance, and fitted with a new pin and bushing. Back in service the same day in most cases.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="/emergency/24-7-line-boring"
  schema="EmergencyService"
  emergency={true}
>
  <Header />

  <main>
    <!-- Emergency Hero -->
    <section class="bg-red-700 text-white py-16 md:py-24">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <div class="inline-flex items-center space-x-2 bg-red-600 rounded-full px-4 py-2 text-sm font-bold mb-6">
          <span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>
          <span>24/7 EMERGENCY DISPATCH AVAILABLE NOW</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
          Equipment Down? We're On Our Way.
        </h1>
        <p class="text-xl text-red-100 mb-8 max-w-2xl mx-auto">
          Ontario Mobile Line Boring provides 24/7 emergency on-site line boring, bore welding, and pin-and-bushing replacement across Ontario — including weekends and holidays.
        </p>
        <a
          href="tel:+1-519-555-0123"
          class="inline-flex items-center space-x-3 bg-white text-red-700 hover:bg-red-50 px-10 py-5 rounded-xl font-bold text-2xl transition-colors shadow-lg"
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <!-- TODO: Replace with real phone number -->
          <span>Call Now: (519) 555-0123</span>
        </a>
        <p class="mt-4 text-red-200 text-sm">Tap to call from your mobile device</p>
      </div>
    </section>

    <!-- Response Times -->
    <section class="py-14 bg-gray-900 text-white">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-2xl font-bold text-center mb-8">Estimated Response Times by City</h2>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
          {responseTimes.map(rt => (
            <a href={`/locations/${rt.slug}`} class="bg-gray-800 hover:bg-gray-700 rounded-lg p-4 text-center transition-colors">
              <div class="text-lg font-bold text-white mb-1">{rt.city}</div>
              <div class="text-red-400 font-semibold text-sm">{rt.time}</div>
            </a>
          ))}
        </div>
        <p class="text-gray-400 text-sm text-center mt-4">
          Response times are estimates from time of dispatch. Actual times may vary based on traffic, weather, and technician availability. Verify with our dispatch team when you call.
        </p>
      </div>
    </section>

    <!-- Downtime Calculator -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-2xl">
        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">Downtime Cost Calculator</h2>
          <p class="text-gray-600">
            Estimate the cost of equipment downtime to understand the real value of fast repair. This calculator provides a rough estimate — not a repair quote.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 md:p-8 border border-gray-200">
          <form id="downtime-form" class="space-y-5" novalidate>
            <div>
              <label for="hourly-rate" class="block text-sm font-semibold text-gray-700 mb-1">
                Equipment Hourly Rate (CAD/hr)
              </label>
              <input
                type="number"
                id="hourly-rate"
                min="0"
                step="1"
                placeholder="e.g., 250"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                aria-describedby="hourly-rate-hint"
              />
              <p id="hourly-rate-hint" class="text-xs text-gray-500 mt-1">Typical excavator: $150–$350/hr; loader: $100–$250/hr</p>
            </div>

            <div>
              <label for="lost-revenue" class="block text-sm font-semibold text-gray-700 mb-1">
                Lost Revenue / Hour (CAD/hr)
              </label>
              <input
                type="number"
                id="lost-revenue"
                min="0"
                step="1"
                placeholder="e.g., 500"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                aria-describedby="lost-revenue-hint"
              />
              <p id="lost-revenue-hint" class="text-xs text-gray-500 mt-1">Revenue your operation loses while the machine is down</p>
            </div>

            <div>
              <label for="downtime-hours" class="block text-sm font-semibold text-gray-700 mb-1">
                Estimated Downtime (hours)
              </label>
              <input
                type="number"
                id="downtime-hours"
                min="0"
                step="0.5"
                placeholder="e.g., 16"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
              />
            </div>

            <div id="calc-error" class="hidden bg-red-50 border border-red-200 rounded-lg p-3 text-red-600 text-sm"></div>

            <button
              type="button"
              id="calc-btn"
              class="w-full bg-red-600 hover:bg-red-700 text-white px-6 py-4 rounded-lg font-bold text-lg transition-colors"
            >
              Calculate Downtime Cost
            </button>
          </form>

          <!-- Result -->
          <div id="calc-result" class="hidden mt-6 bg-red-50 border-2 border-red-300 rounded-lg p-6 text-center">
            <p class="text-gray-600 text-sm mb-1">Estimated total downtime cost:</p>
            <p id="calc-total" class="text-4xl font-bold text-red-600 mb-2"></p>
            <p class="text-xs text-gray-500 italic mb-4">
              Formula: (Equipment Hourly Rate + Lost Revenue/hr) × Downtime Hours. This is an estimate only — not a repair quote.
            </p>
            <a
              href="tel:+1-519-555-0123"
              class="inline-flex items-center space-x-2 bg-red-600 text-white hover:bg-red-700 px-6 py-3 rounded-lg font-bold transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <span>Call Now to Minimize This Cost</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Emergency Process -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 text-center mb-10">Our Emergency Response Process</h2>
        <ol class="space-y-8">
          {emergencySteps.map(step => (
            <li class="flex space-x-5">
              <div class="w-12 h-12 bg-red-600 text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0">
                {step.num}
              </div>
              <div class="pt-1">
                <h3 class="text-lg font-bold text-gray-900 mb-1">{step.title}</h3>
                <p class="text-gray-600">{step.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Service Coverage -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Emergency Service Coverage</h2>
        <p class="text-gray-600 mb-6">We currently dispatch for emergency service across the following Ontario cities and surrounding areas:</p>
        <div class="flex flex-wrap justify-center gap-3">
          {responseTimes.map(rt => (
            <a href={`/locations/${rt.slug}`} class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg font-semibold transition-colors">
              {rt.city}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-16 bg-red-700 text-white">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4">Don't Let Downtime Drain Your Budget</h2>
        <p class="text-red-100 mb-8 max-w-xl mx-auto">
          Every hour of equipment downtime costs you money. Call now — our dispatch team will get a technician to your site as quickly as possible.
        </p>
        <a
          href="tel:+1-519-555-0123"
          class="inline-flex items-center space-x-3 bg-white text-red-700 hover:bg-red-50 px-10 py-5 rounded-xl font-bold text-xl transition-colors"
        >
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <!-- TODO: Replace with real phone number -->
          <span>(519) 555-0123 — Call Now</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const calcBtn = document.getElementById('calc-btn');
  const calcResult = document.getElementById('calc-result');
  const calcTotal = document.getElementById('calc-total');
  const calcError = document.getElementById('calc-error');

  calcBtn?.addEventListener('click', () => {
    const hourlyRate = parseFloat((document.getElementById('hourly-rate') as HTMLInputElement).value) || 0;
    const lostRevenue = parseFloat((document.getElementById('lost-revenue') as HTMLInputElement).value) || 0;
    const downtimeHours = parseFloat((document.getElementById('downtime-hours') as HTMLInputElement).value) || 0;

    if (downtimeHours <= 0) {
      if (calcError) {
        calcError.textContent = 'Please enter a downtime duration greater than 0.';
        calcError.classList.remove('hidden');
      }
      calcResult?.classList.add('hidden');
      return;
    }
    if (hourlyRate < 0 || lostRevenue < 0) {
      if (calcError) {
        calcError.textContent = 'Hourly rate and lost revenue cannot be negative.';
        calcError.classList.remove('hidden');
      }
      calcResult?.classList.add('hidden');
      return;
    }

    calcError?.classList.add('hidden');
    const total = (hourlyRate + lostRevenue) * downtimeHours;
    if (calcTotal) {
      calcTotal.textContent = `$${total.toLocaleString('en-CA', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} CAD`;
    }
    calcResult?.classList.remove('hidden');
  });
</script>
