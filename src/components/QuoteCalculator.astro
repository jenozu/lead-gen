---
// Quote Calculator Component
// TODO: Replace placeholder phone before launch
---

<div class="bg-white rounded-xl shadow-lg p-6 md:p-8">
  <h3 class="text-2xl font-bold text-gray-900 mb-2">Get Your Preliminary Estimate in 60 Seconds</h3>
  <p class="text-gray-600 mb-6">
    Fill out the form below for a preliminary price range. All estimates are subject to on-site technician assessment.
  </p>

  <form id="quote-form" class="space-y-4" novalidate>
    <div>
      <label for="equipment-type" class="block text-sm font-semibold text-gray-700 mb-2">
        Equipment Type <span aria-hidden="true">*</span>
      </label>
      <select
        id="equipment-type"
        name="equipmentType"
        required
        aria-required="true"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent"
      >
        <option value="">Select equipment type</option>
        <option value="excavator">Excavator</option>
        <option value="loader">Loader</option>
        <option value="dozer">Dozer</option>
        <option value="backhoe">Backhoe</option>
        <option value="agricultural">Agricultural Equipment</option>
        <option value="industrial">Industrial Machinery</option>
        <option value="other">Other</option>
      </select>
    </div>

    <div>
      <label for="bore-size" class="block text-sm font-semibold text-gray-700 mb-2">
        Bore Size (inches) <span aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="bore-size"
        name="boreSize"
        placeholder="e.g., 4.5"
        required
        aria-required="true"
        pattern="^\d+(\.\d+)?$"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent"
      />
      <p class="text-xs text-gray-500 mt-1">Enter a numeric value in inches (e.g., 3, 4.5, 8)</p>
    </div>

    <div>
      <label for="location" class="block text-sm font-semibold text-gray-700 mb-2">
        Location <span aria-hidden="true">*</span>
      </label>
      <select
        id="location"
        name="location"
        required
        aria-required="true"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent"
      >
        <option value="">Select your city</option>
        <option value="Guelph, ON">Guelph, ON</option>
        <option value="Peterborough, ON">Peterborough, ON</option>
        <option value="Kingston, ON">Kingston, ON</option>
        <option value="Sarnia, ON">Sarnia, ON</option>
        <option value="Belleville, ON">Belleville, ON</option>
        <option value="Other, ON">Other Ontario location</option>
      </select>
    </div>

    <div>
      <label for="urgency" class="block text-sm font-semibold text-gray-700 mb-2">
        Urgency Level <span aria-hidden="true">*</span>
      </label>
      <select
        id="urgency"
        name="urgency"
        required
        aria-required="true"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent"
      >
        <option value="standard">Standard (1–2 business days)</option>
        <option value="urgent">Urgent (Same day)</option>
        <option value="emergency">Emergency (As soon as possible)</option>
      </select>
    </div>

    <div>
      <label for="additional-details" class="block text-sm font-semibold text-gray-700 mb-2">
        Additional Details (Optional)
      </label>
      <textarea
        id="additional-details"
        name="additionalDetails"
        rows="3"
        placeholder="Describe the repair needed, number of bores, equipment model, etc."
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent"
      ></textarea>
    </div>

    <!-- Validation error summary -->
    <div id="form-error" class="hidden bg-red-50 border border-red-300 rounded-lg p-3">
      <p class="text-red-700 text-sm font-semibold">Please correct the following:</p>
      <ul id="error-list" class="text-red-600 text-sm mt-1 list-disc list-inside"></ul>
    </div>

    <button
      type="submit"
      id="submit-btn"
      class="w-full bg-blue-600 hover:bg-blue-700 text-white px-6 py-4 rounded-lg font-bold text-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
    >
      Get Preliminary Estimate
    </button>
  </form>

  <!-- Quote Result -->
  <div id="quote-result" class="hidden mt-6 bg-blue-50 border-2 border-blue-200 rounded-lg p-6">
    <h4 class="font-bold text-gray-900 mb-1">Your Preliminary Estimate</h4>
    <p class="text-xs text-gray-500 mb-4 italic">
      This is a preliminary estimate only. Final pricing is subject to on-site technician assessment and may vary based on actual bore condition.
    </p>
    <div id="quote-details" class="space-y-2 text-sm text-gray-700">
      <!-- Dynamic content inserted by JS -->
    </div>
    <div class="mt-4 pt-4 border-t border-blue-200 space-y-3">
      <p class="text-sm text-gray-600">
        <strong>Next Steps:</strong> Call us to confirm your booking, or submit your contact information and a technician will follow up to schedule service.
      </p>
      <a
        href="tel:+1-519-555-0123"
        class="inline-flex items-center space-x-2 bg-blue-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
        </svg>
        <span>Call to Confirm Booking</span>
      </a>
    </div>
  </div>

  <!-- Error Message -->
  <div id="quote-error" class="hidden mt-6 bg-red-50 border-2 border-red-200 rounded-lg p-4">
    <p class="text-red-600 font-semibold">
      Unable to generate an estimate. Please call us directly to discuss your repair.
    </p>
  </div>
</div>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const quoteResult = document.getElementById('quote-result');
  const quoteDetails = document.getElementById('quote-details');
  const quoteError = document.getElementById('quote-error');
  const formError = document.getElementById('form-error');
  const errorList = document.getElementById('error-list');

  function validateForm(): string[] {
    const errors: string[] = [];
    const equipmentType = (document.getElementById('equipment-type') as HTMLSelectElement).value;
    const boreSize = (document.getElementById('bore-size') as HTMLInputElement).value.trim();
    const location = (document.getElementById('location') as HTMLSelectElement).value;

    if (!equipmentType) errors.push('Please select an equipment type.');
    if (!boreSize) {
      errors.push('Please enter a bore size.');
    } else if (!/^\d+(\.\d+)?$/.test(boreSize)) {
      errors.push('Bore size must be a number (e.g., 4.5).');
    } else if (parseFloat(boreSize) <= 0 || parseFloat(boreSize) > 48) {
      errors.push('Bore size must be between 0 and 48 inches.');
    }
    if (!location) errors.push('Please select a location.');
    return errors;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const errors = validateForm();
    if (errors.length > 0) {
      if (errorList) errorList.innerHTML = errors.map(err => `<li>${err}</li>`).join('');
      formError?.classList.remove('hidden');
      return;
    }

    formError?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Getting estimate…';

    const formData = {
      equipmentType: (document.getElementById('equipment-type') as HTMLSelectElement).value,
      boreSize: (document.getElementById('bore-size') as HTMLInputElement).value.trim(),
      location: (document.getElementById('location') as HTMLSelectElement).value,
      urgency: (document.getElementById('urgency') as HTMLSelectElement).value,
      additionalDetails: (document.getElementById('additional-details') as HTMLTextAreaElement).value,
    };

    try {
      const response = await fetch('/api/quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData),
      });

      const data = await response.json();

      if (response.ok && data.success) {
        const q = data.quote;
        if (quoteDetails) {
          quoteDetails.innerHTML = `
            <div class="flex justify-between"><span>Equipment:</span><strong class="capitalize">${q.equipmentType}</strong></div>
            <div class="flex justify-between"><span>Bore Size:</span><strong>${q.boreSize}"</strong></div>
            <div class="flex justify-between"><span>Location:</span><strong>${q.location}</strong></div>
            <div class="flex justify-between"><span>Urgency:</span><strong class="capitalize">${q.urgency}</strong></div>
            <div class="flex justify-between"><span>Turnaround:</span><strong>${q.turnaround}</strong></div>
            <div class="flex justify-between text-lg font-bold text-blue-600 mt-4 pt-4 border-t border-blue-200">
              <span>Preliminary Range:</span>
              <span>$${q.estimatedPrice.min.toLocaleString('en-CA')} – $${q.estimatedPrice.max.toLocaleString('en-CA')} CAD</span>
            </div>
            <p class="text-xs text-gray-500 mt-2 italic">Valid for ${q.validFor}. Subject to on-site inspection.</p>
          `;
        }
        quoteResult?.classList.remove('hidden');
        quoteError?.classList.add('hidden');
      } else {
        quoteError?.classList.remove('hidden');
        quoteResult?.classList.add('hidden');
      }
    } catch {
      quoteError?.classList.remove('hidden');
      quoteResult?.classList.add('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Get Preliminary Estimate';
    }
  });
</script>
